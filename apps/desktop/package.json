{
  "name": "@starflame/desktop",
  "private": true,
  "version": "1.1.7",
  "description": "星焰作业板 Windows 桌面端（Electron）",
  "author": {
    "name": "焰火工作室"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "node scripts/build-main.mjs && node scripts/build-renderer.mjs",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "pack:win7": "node scripts/pack.mjs win7-ia32",
    "pack:win10-x64": "node scripts/pack.mjs win10-x64",
    "pack:win10-ia32": "node scripts/pack.mjs win10-ia32",
    "pack:all": "node scripts/pack.mjs all"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "33.4.11",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "license": "AGPL-3.0-only"
}
