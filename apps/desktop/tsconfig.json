{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "lib": ["ES2021", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
