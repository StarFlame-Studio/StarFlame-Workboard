# 服务端口（宝塔 Nginx 反代到这个端口）
PORT=3002
NODE_ENV=production

# 阿里云 RDS MySQL：库名 starflame-workboard
DATABASE_URL=mysql://user:password@rm-xxxx.mysql.rds.aliyuncs.com:3306/starflame-workboard

# JWT 签名密钥，务必改成 64 位随机串
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=2h
REFRESH_TOKEN_DAYS=30

# 允许跨域的前端域名（逗号分隔）
CORS_ORIGINS=https://zy.yanhuoyiyou.cn,https://zyadmin.yanhuoyiyou.cn,http://localhost:3031,http://localhost:3032

# 七牛云 Kodo（图床）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=oss.yanhuoyiyou.cn

LOG_LEVEL=info
